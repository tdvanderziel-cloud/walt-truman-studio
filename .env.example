# Copy this file to ".env" and fill in your own keys.
# Never share .env and never put it on GitHub (.gitignore already blocks it).

# Claude (analysis + fact-check). Create a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# ElevenLabs (transcription + Walt's voice). elevenlabs.io > Developers > API keys.
# The key needs these permissions: Speech to Text, Text to Speech, Voices (read).
ELEVENLABS_API_KEY=

# Port for the local studio page (http://localhost:4321)
PORT=4321

# Optional: ElevenLabs speech-to-text model (default scribe_v1)
# ELEVENLABS_STT_MODEL=

# Optional: full paths if a tool is not found automatically
# YTDLP_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=
